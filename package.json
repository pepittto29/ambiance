{
  "name": "ambiance",
  "productName": "Ambiance",
  "version": "1.0.0",
  "description": "Bruits blancs et ambiances sonores pour se concentrer, se détendre et dormir.",
  "main": "main.js",
  "author": "Pierre",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pierre.ambiance",
    "productName": "Ambiance",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet-main.js",
      "pet-preload.js",
      "pet-world.js",
      "pet-win32.js",
      "pet-memory.js",
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ambiance"
    }
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "uiohook-napi": "^1.5.4"
  }
}
