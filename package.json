{
  "name": "ambiance",
  "productName": "Ambiance",
  "version": "1.3.0",
  "description": "Bruits blancs et ambiances sonores pour se concentrer, se détendre et dormir.",
  "main": "main.js",
  "author": "Pierre",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.pierre.ambiance",
    "productName": "Ambiance",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet-main.js",
      "pet-preload.js",
      "pet-world.js",
      "pet-win32.js",
      "pet-memory.js",
      "modes.js",
      "clock.js",
      "tasks.js",
      "music.js",
      "music-helper.ps1",
      "spotify.js",
      "win-settings.js",
      "src/**/*",
      "assets/**/*",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/!(win32_x64|win32_arm64)/**",
      "!node_modules/uiohook-napi/prebuilds/!(win32-x64)/**",
      "!node_modules/uiohook-napi/{src,libuiohook,build}/**",
      "!src/sounds/credits-freesound.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ambiance"
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "uiohook-napi": "^1.5.4"
  }
}
